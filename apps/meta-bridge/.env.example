PORT=4000
# Address of the VoroniX API (the app from the main README)
VORONIX_URL=http://localhost:3000

# Meta app: App settings > Basic > App secret
META_APP_SECRET=
# Any string you invent; paste the same one in Meta's webhook settings
META_VERIFY_TOKEN=

# One entry per connected number or Instagram account.
#   key    = "whatsapp:<Phone number ID>" or "instagram:<Instagram account ID>"
#   business = VoroniX business id (shown on the Integrations page)
#   secret = x-channel-secret of that business (Integrations page)
#   token  = Meta access token (permanent System User token for WhatsApp, Page/IG token for Instagram)
BUSINESS_MAP={"whatsapp:123456789012345":{"business":"BUSINESS_ID","secret":"CHANNEL_SECRET","token":"EAAG..."},"instagram:17841400000000000":{"business":"BUSINESS_ID","secret":"CHANNEL_SECRET","token":"EAAG..."}}

# Optional
GRAPH_VERSION=v21.0
# Use https://graph.instagram.com if you use "Instagram API with Instagram Login"
INSTAGRAM_GRAPH_BASE=https://graph.facebook.com
