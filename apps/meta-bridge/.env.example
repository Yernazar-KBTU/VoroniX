PORT=4000
VORONIX_URL=https://your-voronix.example.com
META_APP_SECRET=
META_VERIFY_TOKEN=
# One line of JSON. Keys: "whatsapp:<Phone number ID>" and "instagram:<Instagram account ID>"
BUSINESS_MAP={"whatsapp:111":{"business":"biz1","secret":"x-channel-secret","token":"META_TOKEN"}}
GRAPH_VERSION=v21.0

# Voice / photo / video understanding. Leave MEDIA_AI_KEY empty to keep text-only mode.
MEDIA_AI_KEY=
MEDIA_AI_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1
VISION_MODEL=gpt-4o-mini
MAX_MEDIA_MB=20
