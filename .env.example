# Copy to .env and adjust. Only DATABASE_URL is required.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
PORT=3000
TZ=Asia/Almaty
LOG_LEVEL=info

# AI: without a key the built-in offline rule engine answers clients.
ANTHROPIC_API_KEY=
AI_ENGINE=auto            # auto | claude | offline
AI_MODEL=claude-opus-5-5
AI_EFFORT=low

# Channels
TELEGRAM_BOT_TOKEN=
CHANNEL_WEBHOOK_SECRET=

# Optional basic auth for the admin UI
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Allows POST /api/admin/reset-demo (on by default outside production)
ALLOW_DEMO_RESET=true
