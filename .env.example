# Copy to .env and adjust. Only DATABASE_URL is required.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
PORT=3000
LOG_LEVEL=info

# Required for integration credentials; generate 32 random bytes as hex once and keep it stable.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=

# Public address of the app: links in emails and the Google sign-in redirect use it.
APP_URL=http://localhost:3000

# AI: without a key the built-in offline rule engine answers clients.
# This is the platform key every business uses unless it connects its own.
ANTHROPIC_API_KEY=
AI_ENGINE=auto            # auto | claude | offline
AI_MODEL=claude-opus-5-5
AI_EFFORT=low

# Channels: each business connects its own Telegram bot on the Integrations page.
# Optional extra secret that every business's inbound webhook accepts.
CHANNEL_WEBHOOK_SECRET=

# Accounts: people sign up and sign in on the CRM's own page.
# Keep true; false is only for automated tests.
AUTH_REQUIRED=true

# Email for password reset links (https://resend.com). Without a key mails are only logged.
RESEND_API_KEY=
MAIL_FROM=VoroniX <no-reply@your-domain.com>
# Shown as "Help" on the sign-in page. Hidden when empty.
SUPPORT_EMAIL=

# "Continue with Google": OAuth client of type "Web application" in Google Cloud.
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Read-only SQL console on the Database page (teaching tool). Default: on outside
# production, off in production. Keep it off on a server that hosts more than one business.
# SQL_CONSOLE=on

# Allows loading the demo barbershop into a business (POST /api/admin/reset-demo).
# Default: on outside production, off in production.
# ALLOW_DEMO_RESET=true
